# =================================================
# ARENAHUB BACKEND - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env e preencha as suas credenciais.
# =================================================

# URLs do Sistema
ARENAHUB_FRONTEND_URL_PROD=https://arenahub.app
ARENAHUB_BACKEND_URL_PROD=https://api.arenahub.app

# Autenticação & JWT
# Chave secreta de 256 bits codificada em Base64
ARENAHUB_JWT_SECRET_KEY=SEU_JWT_SECRET_KEY_BASE64_AQUI_EXEMPLO

# Banco de Dados PostgreSQL (Local / Container Docker)
ARENAHUB_DB_USER=postgres
ARENAHUB_DB_PASSWORD_LOCAL=postgres

# Banco de Dados PostgreSQL (Produção Externa - Supabase / CloudSQL se usado no perfil 'prod')
ARENAHUB_DB_URL=jdbc:postgresql://seu-host-postgres:5432/arenahub
ARENAHUB_DB_PASSWORD=sua_senha_banco_producao

# Email Administrativo e Envio SMTP (Gmail)
ARENAHUB_ADMIN_EMAIL=admin@arenahub.app
ARENAHUB_GMAIL_APP_PASSWORD=sua_senha_de_aplicativo_gmail

# Envio de SMS / WhatsApp (Zenvia)
ARENAHUB_ZENVIA_API_TOKEN=seu_token_zenvia_api
ARENAHUB_ZENVIA_SENDER_ID=seu_sender_id_zenvia

# Stripe (Gateway de Pagamentos e Assinaturas)
# Ambiente de Teste
ARENAHUB_STRIPE_PUBLIC_KEY_TEST=pk_test_...
ARENAHUB_STRIPE_SECRET_KEY_TEST=sk_test_...
ARENAHUB_STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Ambiente de Produção
ARENAHUB_STRIPE_PUBLIC_KEY_PROD=pk_live_...
ARENAHUB_STRIPE_SECRET_KEY_PROD=sk_live_...
ARENAHUB_STRIPE_WEBHOOK_SECRET_PROD=whsec_...

# Asaas (Gateway de Pagamentos / Pix / Boleto)
ARENAHUB_ASAAS_URL_SANDBOX=https://sandbox.asaas.com/api/v3
ARENAHUB_ASAAS_TOKEN_SANDBOX=$aact_hmlg_...
ARENAHUB_ASAAS_URL_PROD=https://api.asaas.com/v3
ARENAHUB_ASAAS_TOKEN_PROD=$aact_prod_...

# Cloudflare (Opcional - Gerenciamento DNS)
ARENAHUB_DNS_CLOUDFLARE_API_TOKEN=seu_token_api_cloudflare

# Configurações do PGAdmin (Dashboard de BD no Docker Compose - Opcional)
DOCKER_PGADMIN_DEFAULT_EMAIL=admin@arenahub.com
DOCKER_PGADMIN_DEFAULT_PASSWORD=admin123
